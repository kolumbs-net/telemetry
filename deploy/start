#!/bin/bash
# Run the telemetry collector. Started by systemd as the telemetry account,
# with PORT (the UDP port), TELEMETRY_API_PORT, STATE_DIRECTORY and
# RUNTIME_DIRECTORY set by the service slot (infra-orchestrator); everything
# else is the collector's own.
set -euo pipefail

release=$(dirname "$(readlink -f "$0")")

export TELEMETRY_UDP_PORT="$PORT"
export TELEMETRY_DB="$STATE_DIRECTORY/telemetry.db"

exec "$release/telemetry-collector"
