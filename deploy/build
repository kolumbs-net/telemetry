#!/bin/bash
# Build a telemetry collector release into the directory given, on the device
# itself.
#
# Uses only the toolchain the host declares in /etc/kolumbs/toolchain.env
# (infra-orchestrator). The release is the collector binary plus its start
# script. Build output stays in the runner's home, so later builds are
# incremental.
set -euo pipefail

release=${1:?usage: deploy/build <release-dir>}
src=$(cd "$(dirname "$0")/.." && pwd)
manifest=${TOOLCHAIN_MANIFEST:-/etc/kolumbs/toolchain.env}

set -a
. "$manifest"
set +a

export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$HOME/.cache/telemetry/target}
"$CARGO" build --quiet --release --locked --manifest-path "$src/collector/Cargo.toml"

mkdir -p "$release"
cp "$CARGO_TARGET_DIR/release/telemetry-collector" "$release/telemetry-collector"
cp "$src/deploy/start" "$release/start"
